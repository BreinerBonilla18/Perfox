{
  "expo": {
    "name": "Perfox",
    "slug": "perfox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "perfox",
    "userInterfaceStyle": "light",
    "primaryColor": "#6C5CE7",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.perfox.app"
    },
    "android": {
      "package": "com.perfox.app",
      "adaptiveIcon": {
        "backgroundColor": "#6C5CE7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b56acbc-c608-4394-b41a-edf1689adba0"
      }
    }
  }
}
